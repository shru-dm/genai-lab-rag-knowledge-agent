    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst result = items.map((item) => {\n  const date = new Date(item?.json?.timestamp);\n  const month = date.toLocaleString(\"default\", { month: \"long\" });\n  const year = date.getFullYear();\n  const startOfMonth = `1st ${month}`;\n  const endOfMonth = `${new Date(year, date.getMonth() + 1, 0).getDate()}th ${month}`;\n  return { json: { reportMonth: month, startOfMonth, endOfMonth, reportYear: year.toString() } };\n});\nreturn result;\n"
      },
